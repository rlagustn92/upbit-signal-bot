# ─────────────────────────────────────────────────────────────
# 이 파일을 복사해서 .env 파일을 만드세요.  (.env는 git에 올라가지 않습니다)
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# [선택] 업비트 API Key — 화면의 "API Key 변경"으로 등록해도 됩니다(암호화 저장).
# 둘 다 있으면 화면에서 등록한 Key가 우선합니다.
# ⚠ 업비트에서 Key 발급 시 '출금하기' 권한은 반드시 끄세요.
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# 백엔드 포트 (프론트 개발서버가 /api 를 이 포트로 프록시)
SERVER_PORT=8787

# SQLite DB 파일 경로
DATABASE_PATH=./data/bot.db

# 화면에서 등록한 Secret Key 암호화용 마스터 키(32바이트 hex 64자).
# 비워두면 data/master.key 파일을 자동 생성해서 사용합니다.
APP_ENCRYPTION_KEY=

# 모의투자(PAPER) 시작 원화
PAPER_INITIAL_KRW=10000000

# 실전 매매(LIVE) 하드락. true면 어떤 경우에도 실제 주문이 나가지 않습니다.
# 모든 검증을 마친 뒤에만 false로 바꾸세요.
LIVE_TRADING_HARD_LOCK=true

# 로그 레벨: debug | info | warn | error
LOG_LEVEL=info
